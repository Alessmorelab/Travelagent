# 将本文件复制为仓库根目录的 .env；已有 .env 时合并配置，不覆盖原有密钥。
# 百度地图：将你申请的“服务端 AK”填写在等号后。
# 已接入地点检索、国内天气，以及步行/驾车/公交路线工具。
BAIDU_MAP_AK=
# mcp 使用百度托管的 Streamable HTTP；webapi 使用原有直接 API 工具。
BAIDU_MAP_TRANSPORT=mcp
# 仅 webapi 模式且百度应用选择 SN 校验时填写 SK；托管 MCP 按官方协议仅传 AK。
BAIDU_MAP_SK=

# 所有密钥只保存在 Python 服务端。
# Qwen / OpenAI-compatible provider:
TRAVEL_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
TRAVEL_API_KEY=
TRAVEL_MODEL=qwen-plus
# DASHSCOPE_API_KEY may be used instead of TRAVEL_API_KEY.

# For Together instead, remove TRAVEL_API_BASE and configure these:
# TOGETHER_API_KEY=
# TRAVEL_MODEL=your-enabled-model-name

AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# Optional web search for the legacy tools:
TAVILY_API_KEY=

# Deployment database (preferred). URL-encode special characters in the password:
# DATABASE_URL=postgresql+psycopg://roam:YOUR_PASSWORD@127.0.0.1:5432/roam
# Leave empty to use the local SQLite database below. Existing SQLite records stay there;
# changing to PostgreSQL does not automatically transfer those conversations.
DATABASE_URL=
TRAVEL_CHAT_DB=.data/chat.sqlite3

# Optional local PostgreSQL container: docker compose up -d postgres
POSTGRES_USER=roam
POSTGRES_DB=roam
POSTGRES_PASSWORD=
