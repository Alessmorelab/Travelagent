export type Tab = 'assistant' | 'trips' | 'favorites' | 'profile';
export type Agent = 'team' | 'flights' | 'hotels' | 'destinations';
export type Preferences = { origin: string; destination: string; startDate: string; endDate: string; travelers: number; budget: number; style: string };
export type Connection = { mode: 'demo' | 'live'; apiUrl: string };
export type Destination = { id: string; name: string; country: string; category: string; tag: string; days: string; budget: number; image: string; color: string; subtitle: string; description: string };
export type Activity = { time: string; title: string; detail: string; icon: string };
export type Trip = { id: string; title: string; destination: string; destinationId: string | null; startDate: string; endDate: string; travelers: number; budget: number; sample: boolean; days: Activity[][]; completed: string[] };
export type Message = { id: string; role: 'user' | 'assistant'; content: string; agent: Agent; mode: 'demo' | 'live'; status?: 'streaming' | 'interrupted' | 'complete' };
export type Progress = { key: string; label: string; state: 'running' | 'complete' | 'interrupted' };
export type ChatSnapshot = { id: string; title: string; agent: Agent; mode: 'demo' | 'live'; apiUrl?: string; messages: Message[]; thread_id?: string; updated: number };
export type State = { tab: Tab; agent: Agent; filter: string; activeDay: number; busy: boolean; error: string; toast: string; hydrated: boolean; connection: Connection; preferences: Preferences; preferencesConfirmed: boolean; favorites: string[]; trips: Trip[]; messages: Message[]; threads: Partial<Record<Agent, string>>; lastQuery?: string; lastRequestId?: string; progress: Progress[]; chatHistory: ChatSnapshot[]; activeChats: Partial<Record<Agent, string>> };
export const STORAGE_KEY: string;
export const AGENTS: { id: Agent; label: string; icon: string }[];
export const DESTINATIONS: Destination[];
export function initialState(apiUrl?: string): State;
export function validatePreferences(value: Preferences): Preferences;
export function validateConnection(value: Connection): Connection;
export function formatDate(date: string): string;
export function dayCount(trip: Pick<Trip, 'startDate' | 'endDate'>): number;
export function preferenceSummary(p: Preferences): string;
export type TravelSignal = { aborted: boolean; addEventListener(type: string, callback: () => void): void; removeEventListener(type: string, callback: () => void): void };
export type TravelController = { signal: TravelSignal; abort(): void };
export type TravelFetch = (url: string, init?: { method?: string; headers?: Record<string, string>; body?: string; signal?: TravelSignal }) => Promise<{ ok: boolean; status: number; json(): Promise<any> }>;
export type StreamInput = { apiUrl: string; agent: Agent; query: string; preferences: string; threadId?: string; requestId: string; signal: TravelSignal };
export type StreamTransport = (input: StreamInput, onEvent: (event: any) => void) => Promise<{ response: string; thread_id?: string }>;
export function createTravelStore(storage: { getItem(key: string): Promise<string | null>; setItem(key: string, value: string): Promise<unknown> }, options?: { apiUrl?: string; fetch?: TravelFetch; createAbortController?: () => TravelController; validateConnection?: (value: Connection) => Connection; stream?: StreamTransport; demoStreaming?: boolean; demoDelay?: number; timeout?: number }): {
  getState(): State; subscribe(listener: (state: State) => void): () => void; hydrate(): Promise<void>;
  setTab(tab: Tab): void; setAgent(agent: Agent): void; setFilter(filter: string): void; setActiveDay(day: number): void;
  toggleFavorite(id: string): void; savePreferences(value: Preferences): void; setConnection(value: Connection): void;
  testConnection(apiUrl: string): Promise<string>; sendMessage(text: string, retry?: boolean): Promise<void>;
  cancelMessage(): void; clearChat(): void; createTrip(value: Preferences): void; toggleActivity(id: string, key: string): void;
  newConversation(agent?: Agent): void; getChatHistory(): ChatSnapshot[]; restoreConversation(value: ChatSnapshot): void; deleteLocalConversation(id: string): void;
  removeTrip(id: string): void; flush(): Promise<void>; dispose(): void; toast(message: string): void;
};
